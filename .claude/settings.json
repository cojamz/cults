{
  "outputStyle": "Foreman",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "[ -f \"$CLAUDE_PROJECT_DIR/.claude/hooks/bootstrap.sh\" ] && bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/bootstrap.sh\" || true",
            "timeout": 300
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "[ -f \"$CLAUDE_PROJECT_DIR/.claude/hooks/design-rules.sh\" ] && bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/design-rules.sh\" || true",
            "timeout": 20
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Edit|Write|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/.claude/hooks/protect.sh\""
          }
        ]
      },
      {
        "matcher": "mcp__hearthbot__post_message|mcp__hearthbot__edit_message",
        "hooks": [
          {
            "type": "command",
            "command": "[ -f \"$CLAUDE_PROJECT_DIR/.claude/hooks/message-check.mjs\" ] && node \"$CLAUDE_PROJECT_DIR/.claude/hooks/message-check.mjs\" || true"
          }
        ]
      },
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "[ -f \"$CLAUDE_PROJECT_DIR/.claude/hooks/card-gate.mjs\" ] && node \"$CLAUDE_PROJECT_DIR/.claude/hooks/card-gate.mjs\" || true"
          }
        ]
      },
      {
        "matcher": "mcp__hearthbot__post_message|mcp__hearthbot__edit_message|mcp__hearthbot__request_decision|mcp__hearthbot__post_widget",
        "hooks": [
          {
            "type": "command",
            "command": "[ -f \"$CLAUDE_PROJECT_DIR/.claude/hooks/pitch-gate.mjs\" ] && node \"$CLAUDE_PROJECT_DIR/.claude/hooks/pitch-gate.mjs\" || true",
            "timeout": 30
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "[ -f \"$CLAUDE_PROJECT_DIR/.claude/hooks/stop-check.mjs\" ] && node \"$CLAUDE_PROJECT_DIR/.claude/hooks/stop-check.mjs\" || true",
            "timeout": 30
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "cd \"$CLAUDE_PROJECT_DIR\" && node scripts/status.mjs touch >/dev/null 2>&1; echo 'Compacting: after this, re-read design/in-flight.md and your status line (node scripts/status.mjs mine) before continuing.'"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "[ -f \"$CLAUDE_PROJECT_DIR/.claude/hooks/corrections.mjs\" ] && node \"$CLAUDE_PROJECT_DIR/.claude/hooks/corrections.mjs\" || true",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
